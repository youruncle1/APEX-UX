
# Application
APP_PORT=5000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apex_ux
DB_USER=apex
DB_PASSWORD=apex_dev_password
# If DATABASE_URL is set, overrides other db attributes
# DATABASE_URL=postgresql+asyncpg://apex:apex_dev_password@postgres:5432/apex_ux

# Adminer
ADMINER_PORT=8080

# "openai" or "local"
PLANNER_BACKEND=local
UTILITY_BACKEND=local

# OpenAI API Key
# Only needed when PLANNER_BACKEND=openai or UTILITY_BACKEND=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Model names
# Required when using the "local" backend; optional for "openai" (defaults: gpt-4o / gpt-4o-mini)
# PLANNER_MODEL must be a vision-capable (multimodal) model
# UTILITY_MODEL can be any text model
PLANNER_MODEL=
UTILITY_MODEL=

# URL of the local OpenAI-compatible server (used when backend = "local")
# Must expose an OpenAI-compatible API (e.g. llama.cpp, Ollama, vLLM)
# Service must be accessible on 0.0.0.0:<port>
PLANNER_SERVICE_URL=http://host.docker.internal:8001

# Grounding service 
# Service must be accessible on 0.0.0.0:<port>
GROUNDING_SERVICE_URL=http://host.docker.internal:8000

# Memory compression threshold:
# - prevents context overflow during the two-agent navigation loop.
# - Once the action history for a running task exceeds this number of steps,
#   the oldest half is summarised by LLM and replaced with a short narrative,
#   keeping only the most recent (threshold / 2) actions in full detail.
MEMORY_COMPRESSION_THRESHOLD=10

# SUS action compression threshold:
# - prevents context overflow when collecting SUS scores.
# - If total action/steps count across tasks exceed the threshold, 
#   any individual task whose action count exceeds (threshold / num_tasks) 
#   gets its action log summarised by LLM.
SUS_ACTION_CUMULATIVE_THRESHOLD=400

# Browser
HEADLESS=true

# Screenshot storage
# Options: "local" or "s3"
SCREENSHOT_STORAGE_TYPE=local

# Local storage (SCREENSHOT_STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=storage/screenshots

# S3-compatible storage (SCREENSHOT_STORAGE_TYPE=s3)
# unused when using "local"
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=apex-screenshots
S3_REGION=eu-central-1
S3_PUBLIC_URL_BASE=