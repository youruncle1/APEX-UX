# Ports
APP_PORT=5000
DB_PORT=5432
ADMINER_PORT=8080

# Database
DATABASE_URL=YOUR_DATABASE_URL

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Planner Backend: "openai" or "qwen"
PLANNER_BACKEND=openai

# Planner Service (if PLANNER_BACKEND=qwen) - service must be accessbile on 0.0.0.0:port !!
PLANNER_SERVICE_URL=http://host.docker.internal:8001

# Grounding Service
GROUNDING_SERVICE_URL=http://host.docker.internal:8000

# Utility (SEQ, SUS, history summarization) backend: "openai" or "qwen"
# Defaults to "openai". When "qwen", uses the same llama-server as planner.
UTILITY_BACKEND=openai

# Browser
HEADLESS=true

# Screenshot Storage
# Options: "local" or "s3"
SCREENSHOT_STORAGE_TYPE=local

# Local Storage Configuration (SCREENSHOT_STORAGE_TYPE=local)
# Path relative to project root
# Creates: ./storage/screenshots/{evaluation_id}/{task_run_id}/step_XXX.webp
LOCAL_STORAGE_PATH=storage/screenshots

# S3 Storage Configuration (SCREENSHOT_STORAGE_TYPE=s3)
# MinIO:
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=apex-screenshots

# Cloudflare R2:
# S3_ENDPOINT_URL=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY
# S3_SECRET_KEY=YOUR_R2_SECRET_KEY
# S3_BUCKET_NAME=apex-screenshots

S3_REGION=eu-central-1
S3_PUBLIC_URL_BASE=