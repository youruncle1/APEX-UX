
# Application
APP_PORT=5000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apex_ux
DB_USER=apex
DB_PASSWORD=apex_dev_password
# If DATABASE_URL is set, overrides other db attributes
# DATABASE_URL=postgresql+asyncpg://apex:apex_dev_password@postgres:5432/apex_ux

# DB connection pool — increase if running many parallel clones
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Adminer
ADMINER_PORT=8080

# Model hosts and names
# "openai" or "local"
PLANNER_BACKEND=openai
# Required when using the "local" backend; optional for "openai" (defaults: gpt-5.4 / gpt-4o-mini)
# PLANNER_MODEL=gpt-5.4
UTILITY_BACKEND=local
# UTILITY_MODEL can be any text model
# UTILITY_MODEL=gpt-4o-mini

# Temperature for the planner agent and persona self-report (SEQ/SUS).
# Higher values produce more varied, persona-authentic responses.
PLANNER_TEMPERATURE=0.7

# Temperature for utility tasks (memory compression).
UTILITY_TEMPERATURE=0.3

# Parallel clone execution: true = all clones run concurrently (faster, more resource use)
# false = clones run sequentially (easier to debug, lower resource use)
PARALLEL_CLONES=true

# "continue_on_error" (default) or "fail_fast"
# continue_on_error: clone errors are logged, evaluation ends as FAILED
# fail_fast: first clone error stops the entire evaluation immediately, evaluation ends as FAILED
ERROR_POLICY=continue_on_error

# OpenAI API Key
# Only needed when PLANNER_BACKEND=openai or UTILITY_BACKEND=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# URL of the local OpenAI-compatible server (used when backend = "local")
# Must expose an OpenAI-compatible API (e.g. llama.cpp, Ollama, vLLM)
# Service must be accessible on 0.0.0.0:<port>
PLANNER_SERVICE_URL=http://host.docker.internal:8001

# Grounding service 
# Service must be accessible on 0.0.0.0:<port>
GROUNDING_SERVICE_URL=http://host.docker.internal:8000

# Memory compression threshold:
# - prevents context overflow during the two-agent navigation loop.
# - Once the action history for a running task exceeds this number of steps,
#   the oldest half is summarised by LLM and replaced with a short narrative,
#   keeping only the most recent (threshold / 2) actions in full detail.
MEMORY_COMPRESSION_THRESHOLD=20

# SUS action compression threshold:
# - prevents context overflow when collecting SUS scores.
# - If total action/steps count across tasks exceed the threshold, 
#   any individual task whose action count exceeds (threshold / num_tasks) 
#   gets its action log summarised by LLM.
SUS_ACTION_CUMULATIVE_THRESHOLD=400

# Browser
HEADLESS=true

# Milliseconds to wait after each browser action for the page to settle.
# Increase if evaluations capture mid-animation screenshots.
STABILIZATION_WAIT=1000

# Screenshot storage
# Options: "local" or "s3"
SCREENSHOT_STORAGE_TYPE=local

# Local storage (SCREENSHOT_STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=storage/screenshots

# S3-compatible storage (SCREENSHOT_STORAGE_TYPE=s3)
# unused when using "local"
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=apex-screenshots
S3_REGION=eu-central-1
S3_PUBLIC_URL_BASE=